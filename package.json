{
  "name": "init-playwight",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:smoke": "cross-env NODE_ENV=dev npx playwright test **/tests/*.spec.ts -g \"@smoke\"",
    "dev:regression": "cross-env NODE_ENV=dev npx playwright test **/tests/*.spec.ts -g \"@regression\"",
    "dev": "cross-env NODE_ENV=dev npx playwright test",
    "report": "npx playwright show-report",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.4.1"
  }
}
